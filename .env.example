# Copy to .env.local and fill in. .env.local is gitignored.

# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard > Project Settings
# ---------------------------------------------------------------------------
# Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings > API > service_role. SERVER ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Settings > Database > Connection string
# Pooled (Transaction, port 6543) — used at runtime.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Direct (Session, port 5432) — used by drizzle-kit for migrations.
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Midtrans — https://dashboard.midtrans.com > Settings > Access Keys
# ---------------------------------------------------------------------------
# Leave IS_PRODUCTION=false to use the Sandbox environment and test cards.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ---------------------------------------------------------------------------
# Biteship (shipping rates + tracking) — https://biteship.com
# ---------------------------------------------------------------------------
BITESHIP_API_KEY=
# Origin the parcels ship from. Look up via Biteship's /v1/maps/areas endpoint.
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_ORIGIN_POSTAL_CODE=

# ---------------------------------------------------------------------------
# Fonnte (WhatsApp) — https://fonnte.com > Device > Token
# ---------------------------------------------------------------------------
FONNTE_TOKEN=
# Your own number, for low-stock and new-order alerts. Format: 628xxxxxxxxxx
OWNER_WHATSAPP=

# ---------------------------------------------------------------------------
# Resend (transactional email) — https://resend.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Lorechester <orders@yourdomain.com>"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free shipping kicks in at or above this subtotal (rupiah). 0 disables it.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=500000

# ---------------------------------------------------------------------------
# Analytics (optional — omit to disable)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Preview the storefront with fixture data and no database.
# Set to 1 to enable; remove or set to 0 once Supabase is connected.
NEXT_PUBLIC_DEMO_MODE=0
